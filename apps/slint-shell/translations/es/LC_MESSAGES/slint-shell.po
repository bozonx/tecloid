msgstr "Tecla Pegar"

msgid "Sent to the focused app to paste text; the Paste action uses it too. Automatic: Ctrl+V, and Ctrl+Shift+V in terminals. Other values are sent as chosen in every app. Not every app handles the Paste key."
msgstr "Se envía a la aplicación activa para pegar texto; la acción Pegar también lo usa. Automático: Ctrl+V, y Ctrl+Mayús+V en terminales. Los demás valores se envían tal cual en todas las aplicaciones. No todas las aplicaciones admiten la tecla Pegar."

msgid "Print"
msgstr "Imprimir"

msgid "Reopen closed tab"
msgstr "Reabrir pestaña cerrada"

msgid "Next tab"
msgstr "Pestaña siguiente"

msgid "Previous tab"
msgstr "Pestaña anterior"

msgid "Zoom in"
msgstr "Acercar"

msgid "Zoom out"
msgstr "Alejar"

msgid "Reset zoom"
msgstr "Restablecer zoom"

msgid "Toggle comment"
msgstr "Alternar comentario"

msgid "Move to line start"
msgstr "Ir al inicio de la línea"

msgid "Move to line end"
msgstr "Ir al final de la línea"

