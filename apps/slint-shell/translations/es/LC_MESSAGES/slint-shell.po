msgid "Replace to line end with clipboard"
msgstr "Reemplazar hasta el final de la línea con el portapapeles"

msgid "Replace line text with clipboard"
msgstr "Reemplazar el texto de la línea con el portapapeles"

msgid "Select 5 lines down"
msgstr "Seleccionar 5 líneas hacia abajo"

msgid "Remove trigger"
msgstr "Quitar disparador"

msgid "Refresh list"
msgstr "Actualizar lista"

msgid "Remove item"
msgstr "Quitar elemento"

msgid "Save as or reset changes"
msgstr "Guardar como o restablecer cambios"

msgid "Edit: {}"
msgstr "Editar: {}"

msgid "Save (Enter)"
msgstr "Guardar (Intro)"

