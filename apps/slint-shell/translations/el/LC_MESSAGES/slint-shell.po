msgid_plural "Open now: {n} windows"
msgstr[0] "Ανοιχτά τώρα: {n} παράθυρο"
msgstr[1] "Ανοιχτά τώρα: {n} παράθυρα"

msgid "Not open now"
msgstr "Δεν είναι ανοιχτό τώρα"

msgid "Running process"
msgstr "Διεργασία σε εκτέλεση"

