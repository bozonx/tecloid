msgid "Move window to previous screen"
msgstr "ფანჯრის გადატანა წინა ეკრანზე"

msgid "Switch to next desktop"
msgstr "შემდეგ სამუშაო მაგიდაზე გადასვლა"

msgid "Switch to previous desktop"
msgstr "წინა სამუშაო მაგიდაზე გადასვლა"

msgid "Lock screen"
msgstr "ეკრანის ჩაკეტვა"

msgid "Application actions"
msgstr "აპლიკაციების მოქმედებები"

msgid "Actions of installed applications:"
msgstr "დაყენებული აპლიკაციების მოქმედებები:"

msgid "The list is read from the desktop entries of installed applications, the freedesktop standard shared by Linux desktops: applications declare extra actions there, such as opening a new private window. The chosen action is run the way the application menu runs it. Which actions exist depends on the installed applications."
msgstr "სია იკითხება დაყენებული აპლიკაციების .desktop ფაილებიდან — Linux-ის გარემოებისთვის საერთო freedesktop სტანდარტიდან: აპლიკაციები იქ აცხადებენ დამატებით მოქმედებებს, მაგალითად ახალი პირადი ფანჯრის გახსნას. არჩეული მოქმედება ეშვება ისე, როგორც აპლიკაციების მენიუდან. ხელმისაწვდომი მოქმედებები დამოკიდებულია დაყენებულ აპლიკაციებზე."

msgid "In the editor, focus a cell and press Ctrl+X to cut it or Ctrl+C to copy it, then press Ctrl+V on another cell to paste. Escape cancels."
msgstr "რედაქტორში აირჩიეთ უჯრა და დააჭირეთ Ctrl+X ამოსაჭრელად ან Ctrl+C დასაკოპირებლად, შემდეგ სხვა უჯრაზე დააჭირეთ Ctrl+V ჩასასმელად. Escape აუქმებს."

msgid "Follow system"
msgstr "სისტემის მიხედვით"

msgctxt "Accessibility option"
msgid "On"
msgstr "ჩართული"

msgctxt "Accessibility option"
msgid "Off"
msgstr "გამორთული"

msgid "Game mode turns on automatically according to the rules below."
msgstr "თამაშის რეჟიმი ავტომატურად ირთვება ქვემოთ მოცემული წესების მიხედვით."

msgid "Game mode is on manually. The rules below are not applied now."
msgstr "თამაშის რეჟიმი ხელით არის ჩართული. ქვემოთ მოცემული წესები ახლა არ გამოიყენება."

msgid "Game mode is off. The rules below are not applied now."
msgstr "თამაშის რეჟიმი გამორთულია. ქვემოთ მოცემული წესები ახლა არ გამოიყენება."

msgid "Auto mode rules"
msgstr "ავტორეჟიმის წესები"

msgctxt "Game mode rules"
msgid "Inactive"
msgstr "არააქტიური"


msgid "The clipboard is too large or too slow to preserve. Copy a small item and try again. The clipboard was left unchanged."
msgstr "გაცვლის ბუფერი ძალიან დიდი ან ნელია შესანახად. დააკოპირეთ პატარა ელემენტი და სცადეთ ხელახლა. ბუფერი უცვლელი დარჩა."

msgid "Clipboard access is unavailable. Reset text input permissions in Settings and allow clipboard access in the consent dialog."
msgstr "ბუფერზე წვდომა მიუწვდომელია. გადააყენეთ ტექსტის შეყვანის ნებართვები პარამეტრებიდან და დაუშვით ბუფერზე წვდომა თანხმობის დიალოგში."

msgid "No clipboard text transfer was observed. Check the paste shortcut for the destination app, including embedded terminals."
msgstr "ბუფერში ტექსტის გადატანა არ დაფიქსირებულა. შეამოწმეთ პასტის მალსახმობი დანიშნულების აპისთვის, მათ შორის ჩაშენებული ტერმინალები."

msgid "The clipboard is marked sensitive. Copy another item before pasting text so password-manager ownership is preserved."
msgstr "ბუფერში მონიშნულია მგრძნობიარე. დააკოპირეთ სხვა ელემენტი ტექსტის ჩასმამდე, რათა პაროლის მენეჯერის საკუთრება შენარჩუნდეს."

msgid "Reset saved permissions"
msgstr "შენახული ნებართვების განულება"

msgid "The text was not typed: native input failed. Check accessibility permissions and the destination app's privileges."
msgstr "ტექსტი არ იყო აკრეფილი: მშობლიური შეყვანა ვერ მოხერხდა. შეამოწმეთ ხელმისაწვდომობის ნებართვები და დანიშნულების აპის პრივილეგიები."

msgid "Show a hint when Tecloid sends a copy command"
msgstr "მინიშნების ჩვენება, როცა Tecloid აგზავნის კოპირების ბრძანებას"

msgid "Copied"
msgstr "კოპირებულია"

msgid "Enter a late tap from 0 to 5000 ms."
msgstr "შეიყვანეთ დაგვიანებული დაჭერა 0-დან 5000 მწმ-მდე."

msgid "Late tap, ms"
msgstr "დაგვიანებული დაჭერა, მწმ"

msgid "Holding activates the layer as usual. Released within this time with nothing pressed, clicked or scrolled meanwhile, the trigger still runs its tap. 0 turns it off. Empty uses twice the hold threshold: {} ms."
msgstr "დაჭერით დაყოვნება ჩვეულებრივ რთავს ფენას. თუ ამ დროში გაუშვებთ ისე, რომ არაფერს დააჭერთ, არ დააწკაპუნებთ და არ გადაახვევთ, ტრიგერი მაინც შეასრულებს დაჭერის მოქმედებას. 0 გამორთავს. ცარიელი იყენებს დაყოვნების ზღვრის ორმაგ მნიშვნელობას: {} მწმ."

msgid "Used for single-key triggers that activate a layer."
msgstr "გამოიყენება ერთკლავიშიანი ტრიგერებისთვის, რომლებიც ფენას რთავენ."

msgid "Use twice the hold threshold: {} ms"
msgstr "დაყოვნების ზღვრის ორმაგის გამოყენება: {} მწმ"

msgid "Text insertion took too long. Keys typed meanwhile were discarded."
msgstr "ტექსტის ჩასმას ძალიან დიდი დრო დასჭირდა. ამ დროს დაჭერილი კლავიშები გაუქმდა."

msgid "Text input permissions"
msgstr "ტექსტის შეყვანის ნებართვები"

msgid "If you denied the system request or text input stopped working, reset saved permissions. The system will ask again the next time Tecloid enters text."
msgstr "თუ სისტემის მოთხოვნა უარყავით ან ტექსტის შეყვანა აღარ მუშაობს, გაანულეთ შენახული ნებართვები. სისტემა მათ ხელახლა მოითხოვს Tecloid-ით ტექსტის შემდეგი შეყვანისას."

msgid "Saved permissions reset. The system will ask again the next time Tecloid enters text."
msgstr "შენახული ნებართვები განულებულია. სისტემა მათ ხელახლა მოითხოვს Tecloid-ით ტექსტის შემდეგი შეყვანისას."

