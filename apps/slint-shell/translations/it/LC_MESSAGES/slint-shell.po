msgid "On"
msgstr "Attivo"

msgctxt "Accessibility option"
msgid "Off"
msgstr "Disattivo"

msgid "Game mode turns on automatically according to the rules below."
msgstr "La modalità gioco si attiva automaticamente secondo le regole qui sotto."

msgid "Game mode is on manually. The rules below are not applied now."
msgstr "La modalità gioco è attivata manualmente. Le regole qui sotto ora non vengono applicate."

msgid "Game mode is off. The rules below are not applied now."
msgstr "La modalità gioco è disattivata. Le regole qui sotto ora non vengono applicate."

