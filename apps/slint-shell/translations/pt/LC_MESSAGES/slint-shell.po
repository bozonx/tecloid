msgstr "Apenas pré-visualização; as ações não são executadas."

msgid "Retry"
msgstr "Tentar novamente"

msgid "Settings could not be saved"
msgstr "Não foi possível salvar as configurações"

msgid "Retry saving, or discard unsaved settings and continue quitting."
msgstr "Tente salvar novamente ou descarte as configurações não salvas e continue saindo."

msgid "Discard settings and continue"
msgstr "Descartar configurações e continuar"

msgid "The mouse is available."
msgstr "O mouse está disponível."

msgid "Mouse input is active."
msgstr "A entrada do mouse está ativa."

msgid "The selected mouse is disconnected."
msgstr "O mouse selecionado está desconectado."

